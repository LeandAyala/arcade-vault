# Arcade Vault — variables de entorno
# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.
# Las de Resend y SUPABASE_DB_PASSWORD son solo de servidor (sin prefijo NEXT_PUBLIC_).

# Obligatoria. API key de Resend (https://resend.com/api-keys).
# Sin ella, el formulario de contacto responde "Servicio de correo no configurado."
RESEND_API_KEY=

# Obligatoria. Buzón del equipo que recibe los mensajes del formulario de contacto.
# Mientras se use el remitente sandbox onboarding@resend.dev, Resend solo entrega
# al email de la cuenta de Resend: pon aquí ese email hasta verificar un dominio.
CONTACT_TO_EMAIL=

# Opcional. Remitente de los correos.
# Por defecto: "Arcade Vault <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=

# --- Supabase ---------------------------------------------------------------
# Sin NEXT_PUBLIC_SUPABASE_URL o NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY el build pasa,
# el nav muestra "Iniciar Sesión" y /auth responde "Servicio de autenticación no configurado."

# Obligatoria. URL del proyecto (Dashboard → Project Settings → API).
# Ej.: https://mvznnvlgnqwqlwqrmxtt.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Obligatoria. Publishable key del proyecto (sb_publishable_...). Es pública por diseño:
# los datos se protegen con RLS. Nunca pongas aquí una secret key (sb_secret_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo Supabase CLI (npx supabase link / db push). La app nunca la lee.
SUPABASE_DB_PASSWORD=
